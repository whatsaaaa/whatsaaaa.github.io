---
import { github } from '../lib/site';

interface Props {
  /** Where the page is, as a path in the terminal. */
  file: string;
}

const { file } = Astro.props;
---

<footer class="ws-status-line" aria-label="Status">
  <span class="ws-status-line__mode">NORMAL</span>
  <span class="ws-status-line__file">
    <span>{file}</span>
  </span>
  <span class="ws-status-line__spacer"></span>
  <span class="ws-status-line__keys">
    <a href="/projects/" data-ws-key="p">
      <kbd class="ws-kbd">p</kbd>projects
    </a>
    <a href="/ideas/" data-ws-key="i">
      <kbd class="ws-kbd">i</kbd>ideas
    </a>
    <a href={github} data-ws-key="g">
      <kbd class="ws-kbd">g</kbd>github
    </a>
    <button
      type="button"
      data-ws-key="t"
      aria-label="Switch theme"
      data-toggle-theme
    >
      <kbd class="ws-kbd">t</kbd>theme
    </button>
  </span>
  <button
    type="button"
    class="ws-status-line__switch"
    role="switch"
    aria-label="Shortcut keys"
    data-ws-keys-switch
  >
    keys
    <span class="ws-status-line__on" aria-hidden="true">
      on
    </span>
    <span class="ws-status-line__off" aria-hidden="true">
      off
    </span>
  </button>
  {/* On a phone the path needs the room more than the name of the theme, as in the docs
       theme of the design system. */}
  <span class="ws-status-line__item ws-status-line__item--edge ws-status-line__item--wide ws-status-line__item--dark">
    rose-pine
  </span>
  <span class="ws-status-line__item ws-status-line__item--edge ws-status-line__item--wide ws-status-line__item--light">
    rose-pine-dawn
  </span>
</footer>
