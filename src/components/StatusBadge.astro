---
import type { CollectionEntry } from 'astro:content';

interface Props {
  status: CollectionEntry<'projects'>['data']['status'];
}

const { status } = Astro.props;
---

<span class:list={['badge', status]}>{status}</span>

<style>
  .badge {
    flex: none;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.4;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--muted);
  }

  .active {
    color: #15803d;
  }

  .experimental {
    color: #b45309;
  }

  @media (prefers-color-scheme: dark) {
    .active {
      color: #4ade80;
    }

    .experimental {
      color: #fbbf24;
    }
  }
</style>
