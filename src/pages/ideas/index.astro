---
import Entry from '../../components/Entry.astro';
import Listing from '../../components/Listing.astro';
import PromptLink from '../../components/PromptLink.astro';
import Base from '../../layouts/Base.astro';
import { getIdeas, isoDate } from '../../lib/content';

const ideas = await getIdeas();
---

<Base
  title="Ideas"
  description="Ideas by whatsaaaa: things worth building next."
  section="ideas"
  file="~/ideas"
>
  <Listing command="ls ~/ideas" count={ideas.length} level={1}>
    {ideas.map((idea) => (
      <Entry
        href={`/ideas/${idea.id}/`}
        title={idea.data.title}
        description={idea.data.description}
        level={2}
      >
        <time slot="meta" datetime={isoDate(idea.data.date)}>
          {isoDate(idea.data.date)}
        </time>
      </Entry>
    ))}
  </Listing>
  <PromptLink href="/projects/" comment="projects">
    ls ~/projects
  </PromptLink>
</Base>
