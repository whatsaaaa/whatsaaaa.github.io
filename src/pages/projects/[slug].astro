---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Document from '../../components/Document.astro';
import PromptLink from '../../components/PromptLink.astro';
import State from '../../components/State.astro';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, status, tags, links } = project.data;
const { Content } = await render(project);
const file = `~/projects/${project.id}.md`;
---

<Base title={title} description={description} section="projects" file={file}>
  <Document file={file} title={title} lead={description}>
    <div class="facts" slot="facts">
      <State status={status} />
      {tags.length > 0 && (
        <ul class="tags" aria-label="Built with">
          {tags.map((tag) => (
            <li class="ws-tag">{tag}</li>
          ))}
        </ul>
      )}
    </div>
    {links.length > 0 && (
      <ul class="links" slot="facts" aria-label="Links">
        {links.map((link) => (
          <li>
            <a class="ws-arrow" href={link.url}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
    <Content />
  </Document>
  <PromptLink href="/projects/" comment="all projects">
    cd ~/projects
  </PromptLink>
</Base>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ws-space-8) var(--ws-space-16);
    margin-top: var(--ws-space-20);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ws-space-6);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ws-space-8) var(--ws-space-24);
    margin-top: var(--ws-space-20);
    font: var(--ws-text-label);
  }

  /* the arrow stays with the label */
  .links a {
    white-space: nowrap;
  }
</style>
