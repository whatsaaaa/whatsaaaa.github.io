---
import { keysInitScript } from '@whatsaaaa/design-system/shortcuts';
import { themeInitScript } from '@whatsaaaa/design-system/theme';
import { resolver } from '@whatsaaaa/design-system/tokens';
import StatusLine from '../components/StatusLine.astro';
import TabBar from '../components/TabBar.astro';
import { siteDescription, siteName, type Section } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** The section whose tab is current. */
  section?: Section;
  /** Where the page is, as a path in the terminal, for the status line. */
  file: string;
  /** `panes` for the home page, `page` for one scrolling column. */
  layout?: 'panes' | 'page';
  /** Keeps the page out of search engines, and leaves out its canonical URL. */
  noindex?: boolean;
}

const {
  title,
  description = siteDescription,
  section,
  file,
  layout = 'page',
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialCard = new URL('/social-card.png', Astro.site);
// the color of the browser's own bars, from the tokens
const background = (theme: 'dark' | 'light') =>
  resolver.apply({ theme })['color.bg'].$value.hex;
const backgrounds = { dark: background('dark'), light: background('light') };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {/* a remembered theme and keys apply before the first paint, so before the stylesheet */}
    <script is:inline set:html={themeInitScript} />
    <script is:inline set:html={keysInitScript} />
    {/* The browser's own bars take the background of the theme the page shows. While it
         follows the system, the media of each tag picks the theme, and one chosen by hand
         sets both. */}
    <meta
      name="theme-color"
      content={backgrounds.dark}
      media="not (prefers-color-scheme: light)"
      data-theme-for="dark"
    />
    <meta
      name="theme-color"
      content={backgrounds.light}
      media="(prefers-color-scheme: light)"
      data-theme-for="light"
    />
    <script is:inline define:vars={{ backgrounds }}>
      const root = document.documentElement;
      const tags = document.querySelectorAll('meta[name="theme-color"]');
      const color = () => {
        for (const tag of tags) {
          tag.content =
            backgrounds[root.dataset.theme] ??
            backgrounds[tag.dataset.themeFor];
        }
      };
      color();
      new MutationObserver(color).observe(root, {
        attributeFilter: ['data-theme'],
      });
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={siteName} />
    {/* X reads the title, the description and the image from the og: tags */}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="ws-term window">
      <TabBar section={section} />
      {layout === 'panes' ? (
        <main id="main" class="panes">
          <slot />
        </main>
      ) : (
        <main id="main" class="page">
          <div class="column">
            <slot />
          </div>
        </main>
      )}
      <StatusLine file={file} />
    </div>
    <script>
      import { defineGhost } from '@whatsaaaa/design-system/ghost';
      import { enableShortcuts } from '@whatsaaaa/design-system/shortcuts';
      import { toggleTheme } from '@whatsaaaa/design-system/theme';

      defineGhost();
      enableShortcuts();
      // The theme's name is a button per theme, and only the one of the theme shows.
      // When the focused one hides, the focus goes to the one that shows now.
      const names = [
        ...document.querySelectorAll<HTMLElement>('[data-theme-name]'),
      ];
      const keepFocus = (focused: Element | null) => {
        if (
          focused?.matches('[data-theme-name]') &&
          focused.getClientRects().length === 0
        ) {
          names.find((name) => name.getClientRects().length > 0)?.focus();
        }
      };
      for (const control of document.querySelectorAll<HTMLElement>(
        '[data-toggle-theme]',
      )) {
        control.addEventListener('click', () => {
          const focused = document.activeElement;
          toggleTheme();
          keepFocus(focused);
        });
      }
      // the browser lets go of the focus of one that hides, as when the system switches
      for (const name of names) {
        name.addEventListener('focusout', (event) => {
          if (event.relatedTarget === null) keepFocus(name);
        });
      }
    </script>
  </body>
</html>
